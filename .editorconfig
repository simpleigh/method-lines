# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.rst]
indent_size = 3

# Examples use tabs to separate data fields
[*.txt]
indent_style = tab

[*.{yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab
